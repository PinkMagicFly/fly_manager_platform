# ==========================================
# 翔云·低空智慧物流运营平台 Git 忽略规则
# ==========================================

# 编译与构建产物
target/
*.class
bin/
build/
dist/
dist-ssr/
*.jar
*.war
*.ear

# 前端与移动端依赖与生成物
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# UniApp 编译缓存与导出物
unpackage/
.hbuilderx/
.hbuilder/

# IDE 与编辑器配置
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# 日志文件与系统缓存
logs/
*.log
*.log.*
nohup.out
.DS_Store
Thumbs.db
desktop.ini

# 临时测试与调试输出
temp/
tmp/
*.tmp
*.bak
*.swp
*.patch
.attach_pid*

# 敏感与私有环境配置文件
*.local
.env.local
.env.*.local
application-local.yml
application-secret.yml
